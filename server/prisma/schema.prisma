// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  ADMIN
  EMPLOYEE
}

enum OrgPermission {
  // Receipts
  RECEIPT_CREATE
  RECEIPT_EDIT
  RECEIPT_VIEW
  RECEIPT_DELETE

  // Expenses
  EXPENSE_CREATE
  EXPENSE_EDIT
  EXPENSE_VIEW
  EXPENSE_DELETE

  // Statements & matching
  STATEMENT_UPLOAD
  STATEMENT_VIEW
  STATEMENT_DELETE
  MATCH_RUN
  MATCH_REVIEW

  // Members / permissions
  MEMBER_INVITE
  MEMBER_EDIT
  MEMBER_REMOVE

  // Billing
  BILLING_MANAGE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum MatchStatus {
  MATCHED
  NEEDS_REVIEW
  REJECTED
}

enum SalesReportSource {
  POS_UPLOAD
  MANUAL_ENTRY
  API_IMPORT
}

enum SalesReportStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum RecurrenceFrequency {
  MONTHLY
}

enum RecurringChargeStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  CHECK
}

model User {
  id              String   @id @default(cuid())
  firebaseUid     String?  @unique
  email           String   @unique
  name            String?
  preferredLocale String   @default("en-US")
  // timezone      String?  // recommended later
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships OrgUser[]
  ownedOrganizations Organization[]
  uploadedStatements Statement[] @relation("StatementsUploadedBy")
  uploadedSalesReports SalesReport[]
  supportTickets SupportTicket[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  dba       String?  // Doing Business As
  ein       String?  // Employer Identification Number
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional: if you want only ONE user to be "billing owner" for this restaurant
  billingOwnerId String?
  billingOwner   User?    @relation(fields: [billingOwnerId], references: [id])

  members      OrgUser[]
  subscription OrganizationSubscription?

  // Per-org category overrides (only exists when a category is disabled or hidden)
  orgCategories OrgCategory[]

  expenses    Expense[]
  statements  Statement[]
  salesReports SalesReport[]
  matches     ReceiptMatch[]
  recurringCharges RecurringCharge[]
  recurringChargeInstances RecurringChargeInstance[]
  supportTickets SupportTicket[]
  plaidItems       PlaidItem[]

  @@index([billingOwnerId])
}

model OrgUser {
  id          String         @id @default(cuid())
  orgId       String
  userId      String
  role        OrgRole        @default(EMPLOYEE)
  permissions OrgPermission[] // optional fine-grain overrides

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
}

model OrganizationSubscription {
  id                   String             @id @default(cuid())
  orgId                String             @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  plan                 String             // "basic" | "pro" etc.

  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org                  Organization @relation(fields: [orgId], references: [id])

  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

//
// ✅ Per-org category overrides.
// A row only exists here if the org has disabled a category or hidden it from employees.
// The full category list lives in server/src/config/categories.ts as constants.
//
model OrgCategory {
  id          String  @id @default(cuid())
  orgId       String
  categoryKey String  // matches PresetCategoryDef.key e.g. "labor"

  isEnabled          Boolean @default(true)
  visibleToEmployees Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, categoryKey])
  @@index([orgId, isEnabled])
  @@index([orgId, visibleToEmployees])
}

model Expense {
  id          String   @id @default(cuid())
  orgId       String

  // Receipt/scan data (stored directly on expense)
  receiptUrl  String?
  ocrText     String?
  confidence  Float?

  merchant    String?
  amountCents Int
  currency    String   @default("USD")
  paymentMethod PaymentMethod @default(CREDIT_CARD)

  categoryKey          String?  // e.g. "labor" — matches PresetCategoryDef.key
  categoryNameSnapshot String?  // snapshot of name at time of save

  expenseDate DateTime
  notes       String?

  // 🔴 SOFT DELETE
  deletedAt   DateTime?

  // Recurring linkage
  recurringInstanceId String?  @unique
  recurringInstance   RecurringChargeInstance?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id])

  matches     ReceiptMatch[]

  @@index([orgId, expenseDate])
  @@index([orgId, deletedAt])
  @@index([orgId, categoryKey])
}

model Statement {
  id             String   @id @default(cuid())
  orgId          String

  provider       String?
  statementMonth String?  // "2026-01"
  sourceType     String   @default("csv") // "csv" | "pdf"

  uploadedById   String?
  uploadedBy     User?    @relation("StatementsUploadedBy", fields: [uploadedById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org            Organization @relation(fields: [orgId], references: [id])
  transactions   StatementTransaction[]

  @@index([orgId, createdAt])
  @@index([uploadedById])
}

model StatementTransaction {
  id              String   @id @default(cuid())
  statementId     String

  postedDate      DateTime
  transactionDate DateTime?
  merchantRaw     String
  merchantNorm    String?
  amountCents     Int
  currency        String    @default("USD")
  last4           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  statement       Statement @relation(fields: [statementId], references: [id])
  matches         ReceiptMatch[]

  @@index([statementId, postedDate])
  @@index([statementId, amountCents])
  @@index([statementId, merchantNorm])
}

model ReceiptMatch {
  id          String      @id @default(cuid())
  orgId       String
  expenseId   String
  cardTxnId   String

  status      MatchStatus @default(NEEDS_REVIEW)
  score       Float?
  reason      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization         @relation(fields: [orgId], references: [id])
  expense     Expense              @relation(fields: [expenseId], references: [id])
  cardTxn     StatementTransaction @relation(fields: [cardTxnId], references: [id])

  @@unique([expenseId, cardTxnId])
}

model SalesReport {
  id            String            @id @default(cuid())
  orgId         String
  businessDate  DateTime          // the sales day (normalize to midnight in org timezone)

  source        SalesReportSource @default(POS_UPLOAD)
  status        SalesReportStatus @default(PENDING)

  // Original upload (optional but recommended)
  fileUrl       String?
  fileType      String?           // "csv" | "pdf" | "xlsx" etc.
  fileHash      String?           // for duplicate detection

  uploadedById  String?
  uploadedBy    User?             @relation(fields: [uploadedById], references: [id])

  // Core metrics (store in cents to avoid float issues)
  grossSalesCents Int?
  netSalesCents   Int?
  cashCents       Int?
  tipsCents       Int?            // optional but commonly in daily sales reports
  taxCents        Int?            // optional
  discountsCents  Int?            // optional
  refundsCents    Int?            // optional

  currency      String            @default("USD")
  notes         String?

  // Optional: store parsed JSON for debugging (careful with PII)
  parsedPayload Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org           Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, businessDate])          // one report per day per restaurant
  @@index([orgId, businessDate])
}

model RecurringCharge {
  id            String @id @default(cuid())
  orgId         String

  name          String
  merchant      String?
  amountCents   Int
  currency      String @default("USD")

  categoryKey   String?  // e.g. "labor"

  status        RecurringChargeStatus @default(ACTIVE)

  dayOfMonth    Int
  useLastDay    Boolean @default(false)
  startDate     DateTime
  endDate       DateTime?

  lastRunAt     DateTime?
  nextRunAt     DateTime?

  // ✅ soft delete / archive
  deletedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org           Organization @relation(fields: [orgId], references: [id])
  instances     RecurringChargeInstance[]

  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@index([orgId, nextRunAt])
}

model RecurringChargeInstance {
  id                String   @id @default(cuid())
  orgId              String
  recurringChargeId  String
  expenseId          String?  @unique

  // The business date this instance is for (e.g., 2026-02-01)
  runDate            DateTime

  createdAt          DateTime @default(now())

  org                Organization    @relation(fields: [orgId], references: [id])
  recurringCharge    RecurringCharge @relation(fields: [recurringChargeId], references: [id])
  expense            Expense?        @relation(fields: [expenseId], references: [id], map: "expense_recurring_fk")

  // Prevent double-creation for same charge + month/date
  @@unique([recurringChargeId, runDate])
  @@index([orgId, runDate])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(cuid())
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  userId    String
  orgId     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User          @relation(fields: [userId], references: [id])
  org  Organization? @relation(fields: [orgId], references: [id])

  @@index([userId])
  @@index([orgId])
}

model PlaidItem {
  id              String   @id @default(cuid())
  orgId           String
  accessToken     String
  itemId          String   @unique
  institutionId   String?
  institutionName String?
  syncCursor      String?  // cursor for /transactions/sync pagination
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id])
  accounts PlaidAccount[]

  @@index([orgId])
}

model PlaidAccount {
  id               String   @id @default(cuid())
  plaidItemId      String
  accountId        String   @unique
  name             String
  officialName     String?
  type             String
  subtype          String?
  mask             String?
  currentBalance   Float?
  availableBalance Float?
  currency         String   @default("USD")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plaidItem    PlaidItem       @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions CardTransaction[]

  @@index([plaidItemId])
}

model CardTransaction {
  id                           String   @id @default(cuid())
  orgId                        String

  // Plaid identifiers
  plaidTransactionId           String   @unique  // transaction_id from Plaid
  plaidAccountId               String            // FK → PlaidAccount.accountId
  pendingTransactionId         String?           // set when this posted txn replaces a pending one

  // Core financials
  // Plaid convention: positive = money out (debit), negative = money in (credit)
  amount                       Float
  isoCurrencyCode              String?
  unofficialCurrencyCode       String?

  // Dates
  date                         DateTime          // posted date
  authorizedDate               DateTime?         // when card was swiped/authorized
  authorizedDatetime           DateTime?         // full datetime if available
  datetime                     DateTime?         // posted datetime if available

  // Merchant / description
  name                         String            // raw transaction name from Plaid
  merchantName                 String?           // normalized merchant name
  merchantEntityId             String?           // Plaid's stable merchant entity ID
  logoUrl                      String?
  website                      String?

  // Payment context
  paymentChannel               String?           // "in_store" | "online" | "other"
  transactionCode              String?           // e.g. "cash", "atm"
  pending                      Boolean  @default(false)

  // Plaid legacy categories
  categoryId                   String?
  category                     Json?             // String[] from Plaid

  // Plaid personal finance category (newer)
  personalFinanceCategory      String?           // e.g. "FOOD_AND_DRINK"
  personalFinanceCategoryDetail String?          // e.g. "FOOD_AND_DRINK_RESTAURANTS"
  personalFinanceCategoryIconUrl String?

  // Merchant location
  address                      String?
  city                         String?
  region                       String?           // state/province
  postalCode                   String?
  country                      String?
  lat                          Float?
  lon                          Float?

  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  plaidAccount PlaidAccount @relation(fields: [plaidAccountId], references: [accountId])

  @@index([orgId, date])
  @@index([orgId, pending])
  @@index([plaidAccountId, date])
  @@index([pendingTransactionId])
}
